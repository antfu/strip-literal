    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "pnpm": "catalog:cli",
    "publint": "catalog:cli",
    "three": "catalog:testing",
    "tsdown": "catalog:cli",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing",
    "vue": "catalog:testing"
  }
